# ============ Go 构建相关 ============
# 可执行文件
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Go 工作区/依赖缓存
vendor/
.gocache/

# ============ Wails 打包产物 ============
prj/build/bin/
# 图标大图源文件（单张 2MB 左右，不入库；成品 appicon.png / windows/icon.ico 会入库）
# 需要换图标时把新图放到该路径，再执行 prj/build/make-icon.js 重新生成
prj/build/icon-source.png

# 分发包（含 exe 与 WebView2 安装器，体积大不入库；需要时本地重新生成即可）
dist/

# 本地构建工具（如 NSIS 便携版，供 wails build -nsis 使用）
.tools/

# ============ 前端依赖与构建输出 ============
node_modules/
prj/frontend/dist/
*.md5

# ============ IDE / 编辑器 ============
.idea/
.vscode/
*.iml

# ============ 操作系统文件 ============
.DS_Store
Thumbs.db
desktop.ini

# ============ 日志与临时文件 ============
*.log
*.tmp
*.temp